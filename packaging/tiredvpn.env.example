# TiredVPN server environment.
#
# This file is read by the systemd unit (EnvironmentFile=/etc/tiredvpn/env).
# tiredvpn-init fills it in and locks it to mode 0600 - it holds the shared
# secret, so keep it private.

# Listen address as host:port. Empty host means all interfaces.
TIREDVPN_LISTEN=:443

# TLS certificate and key. A self-signed cert is fine - clients authenticate by
# the shared secret, not by the certificate chain.
TIREDVPN_CERT=/etc/tiredvpn/server.crt
TIREDVPN_KEY=/etc/tiredvpn/server.key

# Shared secret (openssl rand -hex 32). Left empty here; tiredvpn-init generates
# one on first run.
TIREDVPN_SECRET=

# Client IP pool (CIDR) for TUN/full-VPN mode. TUN/full-VPN clients (the Android
# app always needs TUN) require this pool; the service brings up ip_forward and
# NAT MASQUERADE for it automatically (via the tiredvpn-nat ExecStartPre helper).
# For a proxy-only server, leave this empty (TIREDVPN_IP_POOL=).
TIREDVPN_IP_POOL=10.8.0.0/24
