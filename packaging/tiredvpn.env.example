# TiredVPN server environment.
#
# This file is read by the systemd unit (EnvironmentFile=/etc/tiredvpn/env).
# tiredvpn-init fills it in and locks it to mode 0600 - it holds the shared
# secret, so keep it private.

# Listen address as host:port. Empty host means all interfaces.
TIREDVPN_LISTEN=:443

# TLS certificate and key. A self-signed cert is fine - clients authenticate by
# the shared secret, not by the certificate chain.
TIREDVPN_CERT=/etc/tiredvpn/server.crt
TIREDVPN_KEY=/etc/tiredvpn/server.key

# Common name for the self-signed cert generated by tiredvpn-init. Anyone who
# opens a TLS connection to this server gets this cert back, so it must not name
# the product, the operator or the country - that would tie the host to every
# other host running the same software. Default "localhost" matches the most
# common self-signed cert on the internet; set a domain the host plausibly owns
# if you have one. Changing this only takes effect with tiredvpn-init --force.
TIREDVPN_CERT_CN=localhost

# Shared secret (openssl rand -hex 32). Left empty here; tiredvpn-init generates
# one on first run.
TIREDVPN_SECRET=

# Client IP pool (CIDR) for TUN/full-VPN mode. TUN/full-VPN clients (the Android
# app always needs TUN) require this pool; the binary brings up ip_forward and
# NAT MASQUERADE for it automatically on start (netlink/nftables, no external
# tools needed). For a proxy-only server, leave this empty (TIREDVPN_IP_POOL=).
TIREDVPN_IP_POOL=10.8.0.0/24

# WAN interface for NAT MASQUERADE, e.g. eth0. Autodetected (route to
# 1.1.1.1) if unset; override only if autodetection picks the wrong one.
#TIREDVPN_WAN_IFACE=
